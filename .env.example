# Folder documents are stored in. Required.
DATA_ROOT=./data

# Certificate and key. Both or neither; see the README on why TLS is not optional.
TLS_CERT=./certs/server-cert.pem
TLS_KEY=./certs/server-key.pem

# Comma-separated. localhost:5173 and localhost:4173 are always allowed.
ALLOWED_ORIGINS=https://flighter7.github.io

# Optional. Defaults to 8443.
# PORT=8443

# Optional. Defaults to <hostname>.local.
# PUBLIC_HOST=my-machine.local

# Optional. Overrides the token stored in <DATA_ROOT>/.token.
# TOKEN=
