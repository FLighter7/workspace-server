{
	"compilerOptions": {
		"target": "ES2023",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"lib": ["ES2023"],
		"types": ["node"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noEmit": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"rewriteRelativeImportExtensions": true,
		"allowImportingTsExtensions": true
	},
	"include": ["src/**/*.ts"]
}
